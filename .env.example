# ==========================================
# LLM Provider Configuration
# ==========================================
# Choose your provider: "openai", "ollama", or "anthropic"
LLM_PROVIDER=openai

# Model specification (e.g. gpt-4o-mini, gpt-4o, claude-3-5-sonnet-20241022, llama3)
LLM_MODEL=gpt-4o-mini

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=

# Local Ollama URL (default: http://localhost:11434/v1)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Maximum reasoning iterations per agent
MAX_AGENT_STEPS=6

# Maximum self-healing debug cycles
MAX_HEALING_CYCLES=3

# Workspace directory for agent code generation
WORKSPACE_DIR=./sandbox

# Subprocess execution timeout in seconds
SUBPROCESS_TIMEOUT=30

# Provider API request timeout in seconds
LLM_TIMEOUT_SECONDS=60.0

# Per-run budget caps (leave blank or comment out for unlimited)
MAX_TOKENS_PER_RUN=
MAX_COST_PER_RUN_USD=

# Tool output truncation cap (characters)
TOOL_OUTPUT_MAX_CHARS=8000

# Tracing integration (Phase 4 preview hook; leave blank for default no-op)
PHOENIX_TRACER_ENABLED=
